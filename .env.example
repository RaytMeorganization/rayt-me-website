# Browser calls same-origin `/backend/*`, rewritten to the API. Leave this unset
# in production unless the API is on a dedicated origin.
# NEXT_PUBLIC_API_URL=https://api.example.com
API_PROXY_TARGET=http://localhost:4000
NEXT_PUBLIC_APP_STORE_URL=https://apps.apple.com/
NEXT_PUBLIC_PLAY_STORE_URL=https://play.google.com/store
