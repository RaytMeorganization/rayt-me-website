# ── Local dev (copy to .env) ─────────────────────────────────────────────
# Next.js :3000  →  rewrites /backend/*  →  API (see ENV.md at repo root)

# Server-side fetch + next.config rewrites (must match backend PORT)
API_PROXY_TARGET=http://127.0.0.1:4000

# Production (GoDaddy VPS): site https://raytme.me · API https://api.raytme.me
# In Docker compose, the web container uses API_PROXY_TARGET=http://api:4000.
# NEXT_PUBLIC_SITE_URL=https://raytme.me
# NEXT_PUBLIC_API_URL=https://api.raytme.me

# Optional: browser calls API origin directly (skip /backend proxy). Usually leave unset locally.
# NEXT_PUBLIC_API_URL=https://api.raytme.me

# Universal Links (iOS). Apple Team ID from App Store Connect → Membership.
# Without it /.well-known/apple-app-site-association serves empty details and
# raytme.me/p/* links open in Safari instead of the app.
# APPLE_TEAM_ID=

# App Links (Android). Comma-separated SHA-256 cert fingerprints for com.raytme.app
# (Play Console → App integrity, or `eas credentials`). Without it
# /.well-known/assetlinks.json serves [] and raytme.me/p/* links open in the browser.
# ANDROID_SHA256_CERT_FINGERPRINTS=

NEXT_PUBLIC_APP_STORE_URL=https://apps.apple.com/
NEXT_PUBLIC_PLAY_STORE_URL=https://play.google.com/store

# Google Search Console — HTML tag verification (content token only, optional)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Marketing-only mode (hide sign-in / sign-up CTAs and routes)
# NEXT_PUBLIC_WEB_SIGN_IN_DISABLED=true
NEXT_PUBLIC_WEB_SIGN_UP_DISABLED=true
