# ── Local dev (copy to .env) ─────────────────────────────────────────────
# Next.js :3000  →  rewrites /backend/*  →  API (see ENV.md at repo root)

# Server-side fetch + next.config rewrites (must match backend PORT)
API_PROXY_TARGET=http://127.0.0.1:4000

# Production (Vercel): keep rate.me on Vercel. Proxy /backend to the API host.
# Do not put the AWS IP on the rate.me A record.
# API_PROXY_TARGET=https://api.rate.me

# Optional: browser calls API origin directly (skip /backend proxy). Usually leave unset locally.
# NEXT_PUBLIC_API_URL=https://api.rate.me

# Universal Links (optional). Apple Team ID from App Store Connect → Membership.
# APPLE_TEAM_ID=

NEXT_PUBLIC_APP_STORE_URL=https://apps.apple.com/
NEXT_PUBLIC_PLAY_STORE_URL=https://play.google.com/store

# Marketing-only mode (hide sign-in / sign-up CTAs and routes)
# NEXT_PUBLIC_WEB_SIGN_IN_DISABLED=true
# NEXT_PUBLIC_WEB_SIGN_UP_DISABLED=true
